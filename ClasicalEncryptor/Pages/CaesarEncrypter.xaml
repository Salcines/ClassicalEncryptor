<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClasicalEncryptor.Pages.CaesarEncrypter">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0"
                       x:Name="clearText"
                       FontAttributes="Bold"
                       FontSize="42"
                       Text="Introduzca el texto a cifrar y su correspondiente 
                       permutación" />
            </Grid>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>